#!/usr/bin/env bash

# sc-sync
#
# Bootstraps and synchronizes dotfiles & shell entrypoints across Linux installations.
# Links configurations from ~/Config into XDG standard locations (~/.config/, ~/.bashrc).

set -uo pipefail

# Add script directory to PATH to locate dep_check
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PATH="$SCRIPT_DIR:$PATH"

dep_check "sc-sync" "bash" || exit 1

CONFIG_DIR="$HOME/Config"
CONFIG_HOME="$HOME/.config"

mkdir -p "$CONFIG_HOME"

printf "\033[1;34m=== Synchronizing Dotfiles & Shell Setup ===\033[0m\n"

# 1. Bootstrap ~/.bashrc
BASHRC_DST="$HOME/.bashrc"
BASH_CUSTOM_MAIN="$CONFIG_DIR/bash-custom/main.sh"

if [[ -f "$BASH_CUSTOM_MAIN" ]]; then
    if ! grep -q "bash-custom/main.sh" "$BASHRC_DST" 2>/dev/null; then
        echo "Updating $BASHRC_DST to entrypoint $BASH_CUSTOM_MAIN..."
        cat <<EOF >> "$BASHRC_DST"

# --- bash-custom Framework Entry ---
if [[ -f "$BASH_CUSTOM_MAIN" ]]; then
    source "$BASH_CUSTOM_MAIN"
fi
EOF
        printf "\033[32m[+] Linked bash-custom entrypoint to ~/.bashrc\033[0m\n"
    else
        printf "\033[36m[=] ~/.bashrc entrypoint already configured.\033[0m\n"
    fi
else
    # Fallback to legacy path if not yet moved
    LEGACY_MAIN="$HOME/Scripts/main.sh"
    if [[ -f "$LEGACY_MAIN" ]] && ! grep -q "Scripts/main.sh" "$BASHRC_DST" 2>/dev/null; then
        cat <<EOF >> "$BASHRC_DST"

# --- bash-custom Framework Entry ---
if [[ -f "$LEGACY_MAIN" ]]; then
    source "$LEGACY_MAIN"
fi
EOF
        printf "\033[32m[+] Linked legacy entrypoint to ~/.bashrc\033[0m\n"
    fi
fi

# 2. Symlink Config Subdirectories (~/Config/<app> -> ~/.config/<app>)
sync_link() {
    local name="$1"
    local src="$CONFIG_DIR/$name"
    local dst="$CONFIG_HOME/$name"

    if [[ -d "$src" ]]; then
        if [[ -L "$dst" ]] && [[ "$(readlink "$dst")" == "$src" ]]; then
            printf "\033[36m[=] Symlink ~/.config/%s is up-to-date.\033[0m\n" "$name"
        else
            [[ -e "$dst" && ! -L "$dst" ]] && mv "$dst" "${dst}.bak.$(date +%s)"
            ln -sfn "$src" "$dst"
            printf "\033[32m[+] Symlinked ~/.config/%s -> %s\033[0m\n" "$name" "$src"
        fi
    fi
}

sync_link "nvim"
sync_link "tmux"
sync_link "fastfetch"

printf "\033[1;32m[✔] Synchronization complete.\033[0m\n"
